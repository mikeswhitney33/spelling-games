<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Paper-cream window background behind the Compose content, so the
         launch frame matches the app instead of flashing white/black. -->
    <style name="Theme.SpellIt" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
